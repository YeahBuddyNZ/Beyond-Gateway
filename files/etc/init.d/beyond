#!/bin/sh /etc/rc.common
# Beyond Gateway at boot: put back the paused devices, and keep looking for the internet until it is found.

START=99
USE_PROCD=1

start_service() {
	/usr/libexec/beyond/apply-pause --no-reload

	[ -n "$(uci -q get beyond.main.wan_mode)" ] && return 0
	procd_open_instance wan-detect
	procd_set_param command /usr/libexec/beyond/wan-detect --until-found
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
