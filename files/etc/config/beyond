# Beyond Gateway's own settings. Devices are kept as "device" sections named after their MAC address.
config beyond 'main'
	option setup_done '0'
	option wan_mode ''


# Updates: check each night; install by themselves only when a grown-up turns this on.
config updates 'updates'
	option auto '0'


# Block Big Tech trackers: advertising, tracking and telemetry from the companies on gobeyond.nz/tech-fines. Off until
# a grown-up turns it on (apply-trackers).
config privacy 'privacy'
	option block_trackers '0'
