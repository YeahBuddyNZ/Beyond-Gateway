#!/bin/sh
# Where mesh points check in each minute (files/usr/libexec/beyond/mesh sync, on the point). Only reachable from the
# house: the firewall keeps the internet away from the router's own pages. beyond.uc's mesh_sync checks the point's
# secret and answers with the Wi-Fi; anything else gets a plain 403.

answer() {
	printf 'Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$1" "$2"
	exit 0
}

[ "$REQUEST_METHOD" = POST ] || answer '405 Method Not Allowed' '{}'
len=$CONTENT_LENGTH
case "$len" in '' | *[!0-9]*) answer '411 Length Required' '{}' ;; esac
[ "$len" -gt 0 ] && [ "$len" -le 32768 ] || answer '413 Payload Too Large' '{}'
body=$(head -c "$len")
case "$body" in '{'*'}') ;; *) answer '400 Bad Request' '{}' ;; esac

# Which address it came from, for the "Open it" link. Added last, so a point can't say it is somewhere else.
from=$REMOTE_ADDR
printf '%s' "$from" | grep -Eqx '[0-9]{1,3}(\.[0-9]{1,3}){3}' || from=''
r=$(ubus call beyond mesh_sync "${body%\}},\"from\":\"$from\"}" 2>/dev/null)
[ "$(printf '%s' "$r" | jsonfilter -e '@.ok' 2>/dev/null)" = true ] || answer '403 Forbidden' '{"ok":false}'
answer '200 OK' "$(printf '%s' "$r" | tr -d '\n\t')"
